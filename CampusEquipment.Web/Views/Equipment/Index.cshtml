@model List<EquipmentDto>
@{
    ViewData["Title"] = "Equipment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Equipment</h1>
    <a asp-action="Create" class="btn btn-primary">Add Equipment</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Asset code, name, or brand" />
    </div>
    <div class="col-md-2">
        <input name="category" value="@ViewBag.Category" class="form-control" placeholder="Category" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var status in new[] { "Available", "Assigned", "UnderMaintenance", "Retired" })
            {
                <option value="@status" selected="@(ViewBag.Status == status)">@status</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="departmentId" asp-items="ViewBag.Departments" class="form-select">
            <option value="">All departments</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Asset Code</th>
                <th>Name</th>
                <th>Category</th>
                <th>Brand</th>
                <th>Model</th>
                <th>Status</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted">No equipment found.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AssetCode</td>
                        <td>@item.Name</td>
                        <td>@item.Category</td>
                        <td>@item.Brand</td>
                        <td>@item.Model</td>
                        <td>@item.Status</td>
                        <td>@item.DepartmentName</td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-primary">Edit</a>
                            @if (item.Status != "Retired")
                            {
                                <form asp-action="Retire" asp-route-id="@item.EquipmentId" method="post" class="d-inline"
                                      onsubmit="return confirm('Retire this equipment?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Retire</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
